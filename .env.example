# BharatMinds AI Backend Configuration

# Server Configuration
PORT=3001
NODE_ENV=development

# Appwrite Configuration
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_API_KEY=your_api_key_here

# Database Configuration
APPWRITE_DATABASE_ID=main_db
APPWRITE_STUDENTS_COLLECTION_ID=students
APPWRITE_USER_PROFILES_COLLECTION_ID=user_profiles
APPWRITE_OPTION_LISTS_COLLECTION_ID=option_lists
APPWRITE_COLLEGE_FEES_COLLECTION_ID=college_fees

# Storage Configuration
APPWRITE_PDF_BUCKET_ID=pdfs

# Security
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug
